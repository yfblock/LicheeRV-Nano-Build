--- 可选内核补丁：支持 R_RISCV_32_PCREL（Rust/LLVM 生成）
--- 若 insmod 报 "Unknown relocation type 57"，需应用此补丁并重编内核
---
diff --git a/arch/riscv/kernel/module.c b/arch/riscv/kernel/module.c
--- a/arch/riscv/kernel/module.c
+++ b/arch/riscv/kernel/module.c
@@ -283,6 +283,20 @@ static int apply_r_riscv_sub64_rela(struct module *me, u32 *location,
 	return 0;
 }
 
+/* R_RISCV_32_PCREL: S + A - P，LLVM/Rust 会生成此重定位 */
+static int apply_r_riscv_32_pcrel_rela(struct module *me, u32 *location,
+					Elf_Addr v)
+{
+	ptrdiff_t offset = (void *)v - (void *)location;
+
+	if (offset != (s32)offset) {
+		pr_err("%s: R_RISCV_32_PCREL offset %lld out of 32-bit range\n",
+		       me->name, (long long)offset);
+		return -EINVAL;
+	}
+	*location = (u32)offset;
+	return 0;
+}
+
 static int (*reloc_handlers_rela[]) (struct module *me, u32 *location,
 				Elf_Addr v) = {
 	[R_RISCV_32]			= apply_r_riscv_32_rela,
@@ -305,6 +319,7 @@ static int (*reloc_handlers_rela[]) (struct module *me, u32 *location,
 	[R_RISCV_ADD32]			= apply_r_riscv_add32_rela,
 	[R_RISCV_ADD64]			= apply_r_riscv_add64_rela,
 	[R_RISCV_SUB32]			= apply_r_riscv_sub32_rela,
 	[R_RISCV_SUB64]			= apply_r_riscv_sub64_rela,
+	[R_RISCV_32_PCREL]		= apply_r_riscv_32_pcrel_rela,
 };
 
 static inline int apply_calc_pcrel_lo12(Elf_Shdr *sechdrs, Elf_Rela *rel,
